{
  "name": "gabarit-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bibliothèque de composants (ui/) et son catalogue",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
