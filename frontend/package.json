{
  "name": "gabarit-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gabarit frontend : authentification, comptes, storybook",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verifier": "esbuild verif/rendu.jsx --bundle --alias:@ui=../storybook/ui --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom --platform=node --format=cjs --jsx=automatic --outfile=verif/.rendu.cjs --log-level=warning && node verif/.rendu.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "vite": "^5.4.8"
  }
}
